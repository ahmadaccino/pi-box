{
  "name": "pi-box",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-source Grok Bot-shaped personal agent. Pi harness, any container, Cloudflare deploy.",
  "license": "MIT",
  "bin": {
    "pi-box": "bin/pi-box.mjs"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --no-warnings scripts/dev.mjs",
    "dev:agent": "node container/server.mjs",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "test": "node scripts/test-allowlist.mjs && node scripts/test-authenticate-url.mjs && node scripts/test-snapshot.mjs && node scripts/test-cdp-fail-closed.mjs && npm run test:mesh-place && npm run test:mesh-roster && npm run test:mesh-routes && npm run test:mesh-chat && npm run test:mesh-snapshot && npm run test:mesh-node && npm run test:mesh-electron",
    "test:mesh-node": "node --experimental-strip-types --no-warnings scripts/mesh-node-check.mjs",
    "test:mesh-electron": "node --experimental-strip-types --no-warnings scripts/mesh-electron-check.mjs",
    "node": "node --experimental-strip-types --no-warnings bin/pi-box.mjs node",
    "test:mesh-place": "node --experimental-strip-types --no-warnings scripts/mesh-place-check.mjs",
    "test:mesh-roster": "node --experimental-strip-types --no-warnings scripts/mesh-roster-check.mjs",
    "test:mesh-routes": "node --experimental-strip-types --no-warnings scripts/mesh-routes-check.mjs",
    "test:mesh-chat": "node --experimental-strip-types --no-warnings scripts/mesh-chat-check.mjs",
    "test:mesh-snapshot": "node --experimental-strip-types --no-warnings scripts/mesh-snapshot-check.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^2.14.0",
    "@cloudflare/containers": "^0.0.30"
  },
  "devDependencies": {
    "wrangler": "^4.28.0"
  }
}
