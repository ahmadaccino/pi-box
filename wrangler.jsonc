{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pi-box",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "containers": [
    {
      "class_name": "PiBox",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 4
    }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "PiBox", "name": "PI_BOX" },
      { "class_name": "Mesh", "name": "MESH" }
    ]
  },
  "r2_buckets": [
    { "binding": "STATE", "bucket_name": "pi-box-state" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PiBox"] },
    { "tag": "v2", "new_sqlite_classes": ["Mesh"] }
  ],
  "browser": { "binding": "BROWSER" },
  "vars": {
    "CLERK_PUBLISHABLE_KEY": ""
  }
}
